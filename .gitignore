# Trained model artifacts required by the backend
# Review their sizes before committing
!artifacts/
artifacts/*
!artifacts/inactivity_logistic_regression.joblib
!artifacts/inactivity_model_metadata.json
!artifacts/customer_segmentation_kmeans.joblib
!artifacts/rfm_standard_scaler.joblib
!artifacts/segmentation_metadata.json

